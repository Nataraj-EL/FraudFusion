# FraudFusion Environment Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Path to Risk Configuration YAML (relative to backend root or absolute)
RISK_CONFIG_PATH=config/risk_config.yaml

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret Key for JWT / Auth Token Signing
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256

